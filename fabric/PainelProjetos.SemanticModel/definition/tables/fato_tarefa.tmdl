table fato_tarefa
	lineageTag: 97ad3432-cf23-59f3-848b-eae30bebe04b
	sourceLineageTag: [dbo].[fato_tarefa]

	measure Tarefas = COUNTROWS ( fato_tarefa )
		formatString: #,0
		displayFolder: Tarefas
		lineageTag: 5dd0e57b-29bd-5ac2-bea6-53669304728a

	measure 'Tarefas Abertas' = CALCULATE ( [Tarefas], fato_tarefa[aberta] = TRUE () )
		formatString: #,0
		displayFolder: Tarefas
		lineageTag: 79362781-e755-591a-8e75-f1efa8c019ba

	measure 'Tarefas Concluídas' = CALCULATE ( [Tarefas], fato_tarefa[status] = "Concluído" )
		formatString: #,0
		displayFolder: Tarefas
		lineageTag: 0615dbbb-e46c-596c-8cf4-bfe11ce24cbd

	measure 'Tarefas Impedidas' = CALCULATE ( [Tarefas], fato_tarefa[status] = "Impedido" )
		formatString: #,0
		displayFolder: Tarefas
		lineageTag: 79078f7a-e7af-55cc-aa1d-d55ec95adccf

	measure 'Tarefas Vencidas' = CALCULATE ( [Tarefas], fato_tarefa[situacao_prazo] = "Vencida" )
		formatString: #,0
		displayFolder: Prazo
		lineageTag: 2e027398-3500-58de-a087-3704318f6776

	measure '% Abertas Vencidas' = DIVIDE ( [Tarefas Vencidas], CALCULATE ( [Tarefas Abertas], NOT ISBLANK ( fato_tarefa[data_limite] ) ) )
		formatString: 0.0%
		displayFolder: Prazo
		lineageTag: bc5f3431-6574-5c87-a618-44d0acc02dab

	measure '% Entregues no Prazo' = ```
			DIVIDE (
			    CALCULATE ( [Tarefas], fato_tarefa[situacao_prazo] = "Concluída no prazo" ),
			    CALCULATE ( [Tarefas], fato_tarefa[situacao_prazo] IN { "Concluída no prazo", "Concluída com atraso" } )
			)
			```
		formatString: 0.0%
		displayFolder: Prazo
		lineageTag: 42aebcbe-738f-55d4-a542-9ace8cd21a6e

	measure 'Atraso Médio das Tarefas (dias)' = CALCULATE ( AVERAGE ( fato_tarefa[dias_atraso] ), fato_tarefa[situacao_prazo] IN { "Vencida", "Concluída com atraso" } )
		formatString: #,0.0
		displayFolder: Prazo
		lineageTag: fbeca6a9-cb98-54b3-a495-37720f5c7f3a

	measure 'Lead Time Médio (dias)' = AVERAGE ( fato_tarefa[lead_time_dias] )
		formatString: #,0.0
		displayFolder: Tempo
		lineageTag: c82d60c7-dde4-51af-9b4c-c8ef56022292

	measure 'Ciclo Médio (dias)' = AVERAGE ( fato_tarefa[ciclo_dias] )
		formatString: #,0.0
		displayFolder: Tempo
		lineageTag: 2d7ae539-fde0-5d10-9e72-e82332cc02f0

	measure 'Ciclo Mediano (dias)' = MEDIAN ( fato_tarefa[ciclo_dias] )
		formatString: #,0.0
		displayFolder: Tempo
		lineageTag: 8f67decc-e910-5cc5-9753-197b737416a1

	measure 'Idade Média das Abertas (dias)' = AVERAGE ( fato_tarefa[idade_dias] )
		formatString: #,0.0
		displayFolder: Tempo
		lineageTag: 381645b3-ee94-5337-8418-805b59aaa7b8

	measure 'Dias Bloqueada' = SUM ( fato_tarefa[dias_bloqueada] )
		formatString: #,0.0
		displayFolder: Tempo
		lineageTag: 80541c9a-5d66-5866-bfa5-048596d35017

	measure '% Concluídas com Retrabalho' = DIVIDE ( CALCULATE ( [Tarefas Concluídas], fato_tarefa[qtd_retrabalho] > 0 ), [Tarefas Concluídas] )
		formatString: 0.0%
		displayFolder: Tempo
		lineageTag: 225604b2-f583-57b0-94ed-8a04a00fdfec

	measure 'Horas Estimadas' = SUM ( fato_tarefa[estimativa_horas] )
		formatString: #,0
		displayFolder: Esforço
		lineageTag: 283a690f-f6fb-5942-abca-7e2e0ca791a2

	measure 'Horas Apontadas' = SUM ( fato_tarefa[horas_apontadas] )
		formatString: #,0
		displayFolder: Esforço
		lineageTag: 8c17e6a2-db2a-5c4c-9bd6-a99baf5c2266

	measure 'Desvio de Esforço %' = ```
			VAR concluidas = FILTER ( fato_tarefa, fato_tarefa[status] = "Concluído" )
			RETURN
			    DIVIDE ( SUMX ( concluidas, fato_tarefa[horas_apontadas] ), SUMX ( concluidas, fato_tarefa[estimativa_horas] ) ) - 1
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Esforço
		lineageTag: 2eafe846-1fdf-5ed4-bbef-4f43b6dc47d5

	measure 'Tarefas Criadas' = [Tarefas]
		formatString: #,0
		displayFolder: Período
		lineageTag: ba343ff7-d113-50ef-9bfe-4d40063b8d1f

	measure 'Tarefas Entregues' = CALCULATE ( [Tarefas Concluídas], USERELATIONSHIP ( fato_tarefa[data_conclusao], dim_data[data] ) )
		formatString: #,0
		displayFolder: Período
		lineageTag: ebe528ea-a459-5da9-b18c-1d7159d9511a

	measure 'Saldo do Período' = [Tarefas Criadas] - [Tarefas Entregues]
		formatString: +#,0;-#,0;0
		displayFolder: Período
		lineageTag: e15e9703-7ff8-50cd-a6e1-c0d9cd29e5ef

	measure '% Tarefas Concluídas' = DIVIDE ( [Tarefas Concluídas], [Tarefas] )
		formatString: 0.0%
		displayFolder: Tarefas
		lineageTag: d61690e2-ac9b-5e51-a144-de8e76b3869b

	measure 'Cronograma Cor' = ```
			VAR ini = MIN ( dim_data[data] )
			VAR fim = MAX ( dim_data[data] )
			VAR ref = MAX ( ref_parametros[data_referencia] )
			RETURN
			    IF (
			        ISINSCOPE ( fato_tarefa[titulo] ),
			        VAR t_ini = CALCULATE ( MIN ( fato_tarefa[data_criacao] ), REMOVEFILTERS ( dim_data ) )
			        VAR t_fim = CALCULATE ( MAX ( fato_tarefa[data_conclusao] ), REMOVEFILTERS ( dim_data ) )
			        VAR situacao = CALCULATE ( MAX ( fato_tarefa[status] ), REMOVEFILTERS ( dim_data ) )
			        VAR prazo = CALCULATE ( MAX ( fato_tarefa[situacao_prazo] ), REMOVEFILTERS ( dim_data ) )
			        VAR ate = IF ( ISBLANK ( t_fim ), ref, t_fim )
			        RETURN
			            IF (
			                NOT ISBLANK ( t_ini ) && t_ini <= fim && ate >= ini,
			                SWITCH (
			                    TRUE (),
			                    situacao = "Concluído", "#5D7398",
			                    situacao = "Arquivada", "#364259",
			                    situacao = "Impedido", "#C4851A",
			                    prazo = "Vencida", "#E44A5D",
			                    "#4682F5"
			                )
			            ),
			        IF (
			            HASONEVALUE ( dim_projeto[projeto] ),
			            VAR p_ini = MAX ( dim_projeto[data_inicio] )
			            VAR p_status = MAX ( dim_projeto[status] )
			            VAR p_fim =
			                SWITCH (
			                    TRUE (),
			                    NOT ISBLANK ( MAX ( dim_projeto[data_conclusao] ) ), MAX ( dim_projeto[data_conclusao] ),
			                    p_status = "Arquivado", MAX ( dim_projeto[data_limite] ),
			                    MAX ( MAX ( dim_projeto[data_limite] ), ref )
			                )
			            RETURN
			                IF (
			                    NOT ISBLANK ( p_ini ) && p_ini <= fim && p_fim >= ini,
			                    SWITCH (
			                        TRUE (),
			                        MAX ( dim_projeto[situacao_prazo] ) = "Atrasado", "#E44A5D",
			                        p_status = "Arquivado", "#364259",
			                        p_status = "Concluído", "#5D7398",
			                        p_status = "Em espera", "#33415E",
			                        "#4682F5"
			                    )
			                )
			        )
			    )
			```
		displayFolder: Cronograma
		lineageTag: d61716e9-2c71-5d26-ae57-ef01654d44e2

	measure Cronograma = IF ( NOT ISBLANK ( [Cronograma Cor] ), " " )
		displayFolder: Cronograma
		lineageTag: cfb723ca-37af-514f-a60e-86b637aa5c50

