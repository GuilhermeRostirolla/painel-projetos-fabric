table fato_passagem_status
	lineageTag: beed866d-d9af-5bfb-b575-1b97c605286b
	sourceLineageTag: [dbo].[fato_passagem_status]

	measure 'Tempo Médio na Etapa (dias)' = CALCULATE ( AVERAGE ( fato_passagem_status[dias_na_etapa] ), fato_passagem_status[etapa_atual] = FALSE () )
		formatString: #,0.0
		displayFolder: Fluxo
		lineageTag: fb1c28d4-38dd-5712-a0f7-4258043bc6bb

	measure 'Tarefas Paradas na Etapa' = ```
			CALCULATE (
			    DISTINCTCOUNT ( fato_passagem_status[tarefa_id] ),
			    fato_passagem_status[etapa_atual] = TRUE (),
			    fato_passagem_status[etapa_final] = FALSE ()
			)
			```
		formatString: #,0
		displayFolder: Fluxo
		lineageTag: 4e60c898-a80e-56b2-86b1-3db760b0488e

	measure 'Paradas há mais de 15 dias' = CALCULATE ( [Tarefas Paradas na Etapa], fato_passagem_status[dias_na_etapa] > 15 )
		formatString: #,0
		displayFolder: Fluxo
		lineageTag: 5b006b6a-ea62-55d0-8432-43b420853005

	measure 'Mudanças de Status' = ```
			// conta pela data da mudança, não pela data de criação da tarefa
			CALCULATE (
			    COUNTROWS ( fato_passagem_status ),
			    USERELATIONSHIP ( fato_passagem_status[data_entrada], dim_data[data] ),
			    CROSSFILTER ( fato_tarefa[data_criacao], dim_data[data], NONE )
			)
			```
		formatString: #,0
		displayFolder: Fluxo
		lineageTag: cd004c63-571b-588f-b485-51c74d04b7b5

	measure 'Bloqueios no Período' = CALCULATE ( [Mudanças de Status], fato_passagem_status[status] = "Impedido" )
		formatString: #,0
		displayFolder: Fluxo
		lineageTag: e87fe2b2-3fb1-520b-886f-949b88d85a43

