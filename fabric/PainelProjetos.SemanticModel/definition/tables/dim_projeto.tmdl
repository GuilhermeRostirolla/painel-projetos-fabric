table dim_projeto
	lineageTag: 612c5a7e-9f7b-5aef-994d-51c1e839da89
	sourceLineageTag: [dbo].[dim_projeto]

	measure Projetos = COUNTROWS ( dim_projeto )
		formatString: #,0
		displayFolder: Portfólio
		lineageTag: 2cc9f825-5e41-5dab-aadc-6e60fd5d50c3

	measure 'Projetos Ativos' = CALCULATE ( [Projetos], dim_projeto[status] IN { "Em Andamento", "Planejamento" } )
		formatString: #,0
		displayFolder: Portfólio
		lineageTag: be077c61-dbfd-51e8-a74e-1bb7a2c58439

	measure 'Projetos em Andamento' = CALCULATE ( [Projetos], dim_projeto[status] = "Em Andamento" )
		formatString: #,0
		displayFolder: Portfólio
		lineageTag: 321602fd-3a0d-56af-97cb-2be663326d81

	measure 'Projetos Concluídos' = CALCULATE ( [Projetos], dim_projeto[status] = "Concluído" )
		formatString: #,0
		displayFolder: Portfólio
		lineageTag: 3ab99b7b-4b44-5a32-b465-0239f11b2b07

	measure 'Projetos Atrasados' = CALCULATE ( [Projetos], dim_projeto[situacao_prazo] = "Atrasado" )
		formatString: #,0
		displayFolder: Prazo
		lineageTag: 220e4557-00a6-55ac-8cbd-983ef84830d7

	measure '% Projetos Atrasados' = DIVIDE ( [Projetos Atrasados], [Projetos Ativos] )
		formatString: 0.0%
		displayFolder: Prazo
		lineageTag: 2f4c0dc3-2322-5892-a3ff-0a9803f4a7a7

	measure '% Projetos Entregues no Prazo' = DIVIDE ( CALCULATE ( [Projetos], dim_projeto[situacao_prazo] = "Concluído no prazo" ), [Projetos Concluídos] )
		formatString: 0.0%
		displayFolder: Prazo
		lineageTag: 4c8b5582-a30f-51c5-9c4d-161623decc0e

	measure 'Atraso Médio dos Projetos (dias)' = CALCULATE ( AVERAGE ( dim_projeto[dias_atraso] ), dim_projeto[situacao_prazo] IN { "Atrasado", "Concluído com atraso" } )
		formatString: #,0.0
		displayFolder: Prazo
		lineageTag: 09ea7136-51a6-5567-b57b-ac756c2a84c2

	measure 'Horas Orçadas' = SUM ( dim_projeto[horas_orcadas] )
		formatString: #,0
		displayFolder: Esforço
		lineageTag: b67f30fe-001e-5503-a159-e1bc41dcd284

	measure '% Orçamento Consumido' = DIVIDE ( [Horas Apontadas], [Horas Orçadas] )
		formatString: 0.0%
		displayFolder: Esforço
		lineageTag: 799b8e6f-04f6-5737-9fb0-1ced7f10f44c

